# --- LLM provider ---
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# --- Search ---
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search

# --- Service auth (backend -> AI service shared secret) ---
AI_SERVICE_API_KEY=change-me
REQUIRE_SERVICE_API_KEY_IN_DEV=false

# --- App ---
ENV=development                 # development | production
APP_NAME=Alfred AI Concierge
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Hosting ---
HOST=0.0.0.0
PORT=8000
